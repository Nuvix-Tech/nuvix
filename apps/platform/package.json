{
  "name": "@nuvix/platform",
  "version": "0.1.0",
  "description": "Nuvix Platform to manage multiple tenants",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "bun ../../scripts/bun-build.ts",
    "postbuild": "bun ../../scripts/gen-pkg.ts platform",
    "start": "bun build/main.js",
    "dev": "bun ../../scripts/bun-build.ts --watch",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "gen:metadata": "bun src/generate-metadata.ts"
  },
  "devDependencies": {
    "@nuvix/core": "workspace:*",
    "@nuvix/pg-meta": "workspace:*",
    "@nuvix/utils": "workspace:*"
  }
}
