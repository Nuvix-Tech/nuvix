{
  "name": "@nuvix/server",
  "version": "1.0.0",
  "description": "Nuvix is a Open Source Backend that provides a set of tools and services to help developers build and deploy applications quickly and efficiently.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "bun ../../scripts/bun-build.ts",
    "dev": "bun ../../scripts/bun-build.ts --watch",
    "start": "bun build/main.js",
    "prebuild": "../../scripts/merge-pkg.js server",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run -c ./vitest.e2e.config.ts",
    "test:unit": "vitest run -c ./vitest.unit.config.ts",
    "gen:metadata": "bun src/generate-metadata.ts"
  },
  "dependencies": {
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@nuvix/core": "workspace:*",
    "@nuvix/utils": "workspace:*"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
