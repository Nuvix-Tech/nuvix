{
  "name": "nuvix-next",
  "private": true,
  "type": "module",
  "description": "Nuvix v2 \u2014 Bun-native backend platform",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "^1.3.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@elysia/openapi": "2.0.0-beta.1",
    "elysia": "2.0.0-beta.6"
  },
  "patchedDependencies": {
    "@elysia/openapi@2.0.0-beta.1": "patches/@elysia%2Fopenapi@2.0.0-beta.1.patch"
  }
}
